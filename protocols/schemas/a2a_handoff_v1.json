{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian.ai/schemas/a2a-handoff-v1.json",
  "title": "A2A Handoff Protocol v1",
  "description": "Schema for Agent-to-Agent handoff documents in the Mindrian platform",
  "type": "object",
  "required": ["protocol", "from_agent", "to_agent", "handoff_type"],
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^a2a/v[0-9]+$",
      "description": "Protocol version identifier",
      "examples": ["a2a/v1"]
    },
    "from_agent": {
      "type": "string",
      "minLength": 1,
      "description": "Agent ID initiating the handoff",
      "examples": ["lawrence", "tta", "ackoff"]
    },
    "to_agent": {
      "type": "string",
      "minLength": 1,
      "description": "Agent ID receiving the handoff",
      "examples": ["lawrence", "tta", "ackoff"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of handoff creation"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "handoff_type": {
      "type": "string",
      "enum": ["switch", "delegate", "consult", "return"],
      "description": "Type of handoff: switch (user moves), delegate (agent asks for help), consult (quick question), return (coming back)"
    },
    "priority": {
      "type": "string",
      "enum": ["urgent", "normal", "background"],
      "default": "normal",
      "description": "Priority level for processing"
    },
    "expects_return": {
      "type": "boolean",
      "default": false,
      "description": "Whether the initiating agent expects a response"
    },
    "return_to": {
      "type": "string",
      "description": "Agent to return to after completion (for delegate/consult)"
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "protocol": "a2a/v1",
      "from_agent": "lawrence",
      "to_agent": "tta",
      "timestamp": "2026-02-01T10:30:00Z",
      "session_id": "abc123",
      "handoff_type": "delegate",
      "priority": "normal",
      "expects_return": true,
      "return_to": "lawrence"
    }
  ]
}
